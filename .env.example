# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不会入库

# 分享链的 HMAC 签名密钥（必填）
# 生成：openssl rand -hex 32
# 未设置时分享功能静默降级：分享链接为空、/share/* 一律 302 回首页
# 更换密钥会让此前生成的所有分享链接立即失效
NPO_SHARE_SECRET=

# 镜像版本（可选，仅影响 docker compose build 的构建参数与镜像标签）
APP_VERSION=dev

# 站点名称（可选），显示在浏览器标题与导航栏品牌位
# 留空或不设则用默认值 "NPO"
#NPO_SITE_NAME=我的笔记本

# 顶部广播条的标题与正文（可选），默认 "广播DEMO" + "这里是广播DEMO内容"
# 只填其中一个则只显示那一部分；两个都写成空值（NPO_BROADCAST_TITLE=）则整条广播不显示
#NPO_BROADCAST_TITLE=
#NPO_BROADCAST_TEXT=

# 站点图标地址（可选），站内相对路径或带 http(s) 的绝对 URL 均可
# 留空或不设则不输出图标链接，浏览器仍会自行请求 /favicon.ico
#NPO_FAVICON=/assets/image/favicon.ico

# 页脚文字（可选），与「© 年份 站点名」合成一行居中显示
# 留空或不设则只有版权（版权同样居中）；写成空值（NPO_FOOTER_TEXT=）效果相同
#NPO_FOOTER_TEXT=由 94Joy 提供

# 空笔记自动清理（可选），默认关闭
# 访客打开首页会被随机分配一个笔记名，看一眼就走会在 _tmp 留下一个空笔记。
# NPO_EMPTY_TTL_DAYS 填天数：空笔记超过这么多天没写过就删掉；0 或不设即不清理。
# 已开分享、设过密码的空笔记，以及 JSON 损坏的文件一律保留；刚写入（60 秒内）的也跳过。
#NPO_EMPTY_TTL_DAYS=30
# 两次扫描的最小间隔（小时），默认 1，最小 1。清理在请求上惰性触发，靠它节流整个目录扫描
#NPO_CLEANUP_INTERVAL_HOURS=1

# 前端 CDN 公共前缀（可选），默认 https://cdn.staticfile.net
# 整站换镜像源时改这一个即可；留空或不是 http(s) 地址都回退默认
#NPO_CDN_BASE=https://cdn.staticfile.net

# 单库地址覆盖（可选），优先级高于上面的前缀，只换某一个库时才用
# 可填 http(s) 绝对地址，或单个 / 开头的站内路径；留空或不设就用前缀拼出的默认地址
#NPO_CDN_JQUERY=
#NPO_CDN_BOOTSTRAP_CSS=
#NPO_CDN_BOOTSTRAP_JS=
#NPO_CDN_FONTAWESOME_CSS=
#NPO_CDN_FONTAWESOME_JS=
#NPO_CDN_WANGEDITOR=
#NPO_CDN_CLIPBOARD=
#NPO_CDN_FILESAVER=
