# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不会入库

# 分享链的 HMAC 签名密钥（必填）
# 生成：openssl rand -hex 32
# 未设置时分享功能静默降级：分享链接为空、/share/* 一律 302 回首页
# 更换密钥会让此前生成的所有分享链接立即失效
NPO_SHARE_SECRET=

# 镜像版本（可选，仅影响 docker compose build 的构建参数与镜像标签）
APP_VERSION=dev

# 站点名称（可选），显示在浏览器标题与导航栏品牌位
# 留空或不设则用默认值 "NPO"
#NPO_SITE_NAME=我的笔记本

# 顶部广播条的标题与正文（可选），默认 "广播DEMO" + "这里是广播DEMO内容"
# 只填其中一个则只显示那一部分；两个都写成空值（NPO_BROADCAST_TITLE=）则整条广播不显示
#NPO_BROADCAST_TITLE=
#NPO_BROADCAST_TEXT=

# 站点图标地址（可选），站内相对路径或带 http(s) 的绝对 URL 均可
# 留空或不设则不输出图标链接，浏览器仍会自行请求 /favicon.ico
#NPO_FAVICON=/assets/image/favicon.ico
